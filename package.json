{
  "name": "raynex-mission-control",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Team Raynex FSOC PAT Mission Control — React dashboard",
  "scripts": {
    "dev": "vite",
    "backend": "python3 backend/run_dashboard.py --no-browser",
    "backend:install": "python3 -m pip install -r backend/requirements.txt",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "15.15.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "5.0.0"
  }
}
